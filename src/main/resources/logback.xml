<?xml version="1.0" encoding="UTF-8"?>
<configuration>

	<appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
		</encoder>
	</appender>

	<!-- The AWS SDK's wire and request loggers print headers and bodies (tokens, secret values): never below WARN -->
	<logger name="software.amazon.awssdk" level="WARN" />
	<logger name="software.amazon.awssdk.request" level="WARN" />
	<logger name="org.apache.http.wire" level="WARN" />
	<logger name="org.apache.http.headers" level="WARN" />
	<logger name="com.zaxxer.hikari" level="INFO" />

	<root level="INFO">
		<appender-ref ref="STDOUT" />
	</root>

</configuration>
