<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.hms</groupId>
	<artifactId>Doctor-Patient-Portal</artifactId>
	<!-- cr-java-0107: Changed from 'war' to 'jar' for executable JAR packaging
	     with embedded Tomcat, enabling container deployment on Amazon ECS/EKS/Fargate
	     without requiring an external application server. -->
	<packaging>jar</packaging>
	<version>0.0.1-SNAPSHOT</version>
	<name>Doctor-Patient-Portal Maven Webapp</name>
	<url>http://maven.apache.org</url>
	<properties>
		<maven.compiler.source>1.8</maven.compiler.source>
		<maven.compiler.target>1.8</maven.compiler.target>
		<hikaricp.version>4.0.3</hikaricp.version>
		<aws.sdk.version>2.25.28</aws.sdk.version>
		<spring.session.version>2.7.4</spring.session.version>
		<spring.data.redis.version>2.7.18</spring.data.redis.version>
		<lettuce.version>6.2.7.RELEASE</lettuce.version>
		<spring.context.version>5.3.39</spring.context.version>
		<!-- Embedded Tomcat version aligned with servlet-api 4.0.1 (Tomcat 9.x) -->
		<tomcat.version>9.0.85</tomcat.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>3.8.1</version>
			<scope>test</scope>
		</dependency>

		<!-- cr-java-0107: servlet-api scope changed from 'provided' to 'compile'
		     because the embedded Tomcat now supplies the servlet container at runtime;
		     there is no external server to provide these classes. -->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<version>4.0.1</version>
			<scope>compile</scope>
		</dependency>

		<!-- https://mvnrepository.com/artifact/mysql/mysql-connector-java -->
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>8.0.28</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/javax.servlet/jstl -->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>jstl</artifactId>
			<version>1.2</version>
		</dependency>

		<!-- https://mvnrepository.com/artifact/javax.el/javax.el-api -->
		<dependency>
			<groupId>javax.el</groupId>
			<artifactId>javax.el-api</artifactId>
			<version>3.0.0</version>
		</dependency>

		<!-- ================================================================ -->
		<!-- HikariCP – cr-java-0073                                          -->
		<!-- Replaces raw DriverManager.getConnection() with a managed        -->
		<!-- connection pool. Works in conjunction with Amazon RDS Proxy for  -->
		<!-- optimised database connections in AWS cloud environments.        -->
		<!-- ================================================================ -->
		<dependency>
			<groupId>com.zaxxer</groupId>
			<artifactId>HikariCP</artifactId>
			<version>${hikaricp.version}</version>
		</dependency>

		<!-- AWS Secrets Manager SDK v2 – replaces hardcoded credentials (cr-java-0113) -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>secretsmanager</artifactId>
			<version>${aws.sdk.version}</version>
		</dependency>

		<!-- AWS SDK v2 HTTP client (required by secretsmanager) -->
		<dependency>
			<groupId>software.amazon.awssdk</groupId>
			<artifactId>apache-client</artifactId>
			<version>${aws.sdk.version}</version>
		</dependency>

		<!-- Jackson Databind – used by SecretsManagerUtil to parse secret JSON -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<version>2.15.4</version>
		</dependency>

		<!-- ================================================================ -->
		<!-- Spring Session Data Redis – cr-java-0065                         -->
		<!-- Replaces in-memory HttpSession with distributed Redis-backed     -->
		<!-- session storage via Amazon ElastiCache for Redis, enabling       -->
		<!-- stateless, horizontally-scalable application instances.          -->
		<!-- ================================================================ -->

		<!-- Spring Context (required by Spring Session) -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context</artifactId>
			<version>${spring.context.version}</version>
		</dependency>

		<!-- Spring Web (required for SpringHttpSessionConfiguration) -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
			<version>${spring.context.version}</version>
		</dependency>

		<!-- Spring Session Core -->
		<dependency>
			<groupId>org.springframework.session</groupId>
			<artifactId>spring-session-core</artifactId>
			<version>${spring.session.version}</version>
		</dependency>

		<!-- Spring Session Data Redis – stores sessions in Redis -->
		<dependency>
			<groupId>org.springframework.session</groupId>
			<artifactId>spring-session-data-redis</artifactId>
			<version>${spring.session.version}</version>
		</dependency>

		<!-- Spring Data Redis – Redis template and connection factory -->
		<dependency>
			<groupId>org.springframework.data</groupId>
			<artifactId>spring-data-redis</artifactId>
			<version>${spring.data.redis.version}</version>
		</dependency>

		<!-- Lettuce – non-blocking Redis client used by Spring Data Redis -->
		<dependency>
			<groupId>io.lettuce</groupId>
			<artifactId>lettuce-core</artifactId>
			<version>${lettuce.version}</version>
		</dependency>

		<!-- ================================================================ -->
		<!-- cr-java-0107: Embedded Tomcat dependencies                       -->
		<!-- Replace external application server with self-contained embedded -->
		<!-- Tomcat, enabling executable JAR deployment on AWS ECS/EKS/Fargate-->
		<!-- ================================================================ -->
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-core</artifactId>
			<version>${tomcat.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-jasper</artifactId>
			<version>${tomcat.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-el</artifactId>
			<version>${tomcat.version}</version>
		</dependency>

	</dependencies>
	<build>
		<plugins>
			<!-- cr-java-0107: Replaced maven-war-plugin with maven-jar-plugin.
			     The application is now packaged as an executable JAR with embedded
			     Tomcat instead of a WAR requiring an external application server.
			     The Main-Class manifest entry points to the embedded server launcher. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.3.0</version>
				<configuration>
					<archive>
						<manifest>
							<mainClass>com.hms.Main</mainClass>
							<addClasspath>true</addClasspath>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<!-- Assembly plugin to produce a fat/uber JAR with all dependencies bundled -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-assembly-plugin</artifactId>
				<version>3.6.0</version>
				<configuration>
					<descriptorRefs>
						<descriptorRef>jar-with-dependencies</descriptorRef>
					</descriptorRefs>
					<archive>
						<manifest>
							<mainClass>com.hms.Main</mainClass>
						</manifest>
					</archive>
				</configuration>
				<executions>
					<execution>
						<id>make-assembly</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
		<finalName>Doctor-Patient-Portal</finalName>
	</build>
</project>
